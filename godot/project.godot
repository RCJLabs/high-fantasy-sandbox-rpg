; Engine configuration file.
; Open this folder in Godot 4 (Project Manager -> Import -> select this project.godot).

config_version=5

[application]

config/name="High Fantasy Sandbox RPG"
config/version="0.1.0-prototype"
run/main_scene="res://ui/title_screen.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

GameState="*res://systems/game_state.gd"
EffectLibrary="*res://systems/effect_library.gd"
Skills="*res://systems/skills.gd"
Attributes="*res://systems/attributes.gd"
Inventory="*res://systems/inventory.gd"
Spellbook="*res://systems/spellbook.gd"
Reputation="*res://systems/reputation.gd"
WorldState="*res://systems/world_state.gd"
Settings="*res://systems/settings.gd"
WorldClock="*res://systems/world_clock.gd"
Survival="*res://systems/survival.gd"
Sfx="*res://systems/sfx.gd"
InputHints="*res://systems/input_hints.gd"
Hints="*res://systems/hints.gd"
KeyBindings="*res://systems/key_bindings.gd"
QuestLog="*res://systems/quest_log.gd"
Character="*res://systems/character.gd"
DialogueManager="*res://ui/dialogue_box.tscn"
SaveSystem="*res://systems/save_system.gd"
CharacterMenu="*res://ui/character_menu.tscn"
PauseMenu="*res://ui/pause_menu.tscn"
RestMenu="*res://ui/rest_menu.gd"
Defeat="*res://systems/defeat.gd"
Openings="*res://systems/openings.gd"
Epilogue="*res://systems/epilogue.gd"
Corruption="*res://systems/corruption.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

