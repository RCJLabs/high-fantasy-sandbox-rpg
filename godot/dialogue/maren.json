	"nodes": {
		"greet": {
			"text": "A traveller! Not many come up the north road these days. I'm Maren - I keep this waystation.",
			"set_flag": "met_maren",
			"choices": [
				{
					"text": "Sergeant Holt sent me from Riverwatch. He said you'd have work.",
					"next": "report_soldier",
					"requires_background": "soldier",
					"requires_flag": "wrong_things_started",
					"requires_not_flag": "maren_wrong_things"
				},
				{
					"text": "The Collegium sent me to study the stones. Noticed anything odd?",
					"next": "report_scholar",
					"requires_background": "scholar",
					"requires_flag": "wrong_things_started",
					"requires_not_flag": "maren_wrong_things"
				},
				{
					"text": "You saw me sleeping behind your waystation. You didn't call the guard.",
					"next": "report_outlaw",
					"requires_background": "outlaw",
					"requires_flag": "wrong_things_started",
					"requires_not_flag": "maren_wrong_things"
				},
				{
					"text": "I'm tracking a Greyfang that walks wrong. Straight lines, no hunting.",
					"next": "report_hunter",
					"requires_background": "hunter",
					"requires_flag": "wrong_things_started",
					"requires_not_flag": "maren_wrong_things"
				},
				{
					"text": "I've come to tend the roadside shrine. Its prayers have gone quiet.",
					"next": "report_acolyte",
					"requires_background": "acolyte",
					"requires_flag": "wrong_things_started",
					"requires_not_flag": "maren_wrong_things"
				},
				{
					"text": "My wagon never reached Riverwatch. Yellow canopy. Did it pass this way?",
					"next": "report_merchant",
					"requires_background": "merchant",
					"requires_flag": "wrong_things_started",
					"requires_not_flag": "maren_wrong_things"
				},
				{
					"text": "I killed the wolves north of here. All of them.",
					"next": "reward",
					"requires_flag": "wolves_cleared"
				},
				{
					"text": "Why don't people come this way?",
					"next": "wolves",
					"requires_not_flag": "wolves_cleared"
				},
				{
					"text": "You're not afraid of an orc on your doorstep?",
					"next": "orc_line",
					"requires_race": "Orc"
				},
				{
					"text": "My people still sing of these hills.",
					"next": "elf_line",
					"requires_race": "Elf"
				},
				{
					"text": "I served in a levy. A waystation this far out must see trouble.",
					"next": "soldier_line",
					"requires_background": "soldier"
				},
				{
					"text": "Those were Greyfang tracks on the road.",
					"next": "hunter_line",
					"requires_background": "hunter"
				},
				{
					"text": "Goodbye.",
					"next": "end"
				}
			]
		},
		"greet_again": {
			"text": "Back again? The kettle's still warm.",
			"choices": [
				{
					"text": "Anything strange around here lately?",
					"next": "wrong_things",
					"requires_flag": "wrong_things_started",
					"requires_not_flag": "maren_wrong_things"
				},
				{
					"text": "I found the hollow wolf.",
					"next": "hollow_found",
					"requires_flag": "saw_hollow_wolf",
					"requires_not_flag": [
						"told_maren_hollow",
						"wrong_things_done"
					]
				},
				{
					"text": "The Greyfang pack is dead.",
					"next": "reward",
					"requires_flag": "wolves_cleared",
					"requires_not_flag": "wolf_quest_done"
				},
				{
					"text": "Tell me about the wolves again.",
					"next": "wolves",
					"requires_not_flag": "wolves_cleared"
				},
				{
					"text": "I'll deal with the Greyfang pack.",
					"next": "accept",
					"requires_flag": "heard_about_wolves",
					"requires_not_flag": [
						"wolf_quest_accepted",
						"wolves_cleared"
					]
				},
				{
					"text": "I have a wolf pelt to sell.",
					"next": "buy_pelt",
					"requires_item": "wolf_pelt"
				},
				{
					"text": "Let's trade.",
					"next": "shop"
				},
				{
					"text": "Goodbye.",
					"next": "end"
				}
			]
		},
		"wolves": {
			"text": "The Greyfang pack. They took two carts last month, and they den past the stone wall, to the north-east. Riverwatch won't send guards past the old bridge.",
			"set_flag": "heard_about_wolves",
			"choices": [
				{
					"text": "Why are they raiding the road at all?",
					"next": "wolves_why",
					"requires_flag": "wrong_things_started"
				},
				{
					"text": "I'll deal with them.",
					"next": "accept",
					"requires_not_flag": [
						"wolf_quest_accepted",
						"wolves_cleared"
					]
				},
				{
					"text": "Sounds like someone else's problem.",
					"next": "end",
					"set_flag": "refused_maren"
				}
			]
		},
		"accept": {
			"text": "Truly? Then may the road be kind to you. Three of them, maybe more. Mind their teeth - and don't let them circle you.",
			"set_flag": "wolf_quest_accepted",
			"choices": [
				{
					"text": "Goodbye.",
					"next": "end"
				}
			]
		},
		"orc_line": {
			"text": "Orcs pay in coin like anyone else. And you'd be handy against what's out there.",
			"choices": [
				{
					"text": "Why don't people come this way?",
					"next": "wolves"
				},
				{
					"text": "Goodbye.",
					"next": "end"
				}
			]
		},
		"elf_line": {
			"text": "Then you'll know the old songs warn of wolves. They weren't wrong.",
			"choices": [
				{
					"text": "Tell me more.",
					"next": "wolves"
				}
			]
		},
		"reward": {
			"text": "All of them? Then the north road is open again. Here - it isn't much, but it's honest coin. And take this, in case the next pack is bigger.",
			"set_flag": "wolf_quest_done",
			"choices": [
				{
					"text": "Glad to help.",
					"next": "end"
				}
			],
			"give_gold": 50,
			"give_item": "minor_healing_potion",
			"add_reputation": {
				"riverwatch": 10
			}
		},
