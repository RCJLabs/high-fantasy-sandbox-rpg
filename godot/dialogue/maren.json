					"next": "bought_tome",
					"requires_gold": 60,
					"requires_not_flag": "bought_tome_healing_ward",
					"set_flag": "bought_tome_healing_ward",
					"take_gold": 60,
					"give_item": "tome_healing_ward"
				},
				{
					"text": "That's all.",
					"next": "end"
				}
			]
		},
		"report_soldier": {
			"text": "Holt's idea of help: one soldier and a nod. Well, you're more than I had yesterday. Some of the work's ordinary, wolves on the road. Some of it isn't.",
			"choices": [
				{
					"text": "What isn't?",
					"next": "wrong_things"
				}
			]
		},
		"report_scholar": {
			"text": "Odd? Everything's been odd since the new moon. The stones hum at night, and that's the least of it. And there's a Collegium man in my back room who's been asking for help with the stones.",
			"choices": [
				{
					"text": "Go on.",
					"next": "wrong_things"
				}
			]
		},
		"report_outlaw": {
			"text": "Didn't see the point. The garrison's got bigger problems than one more face on a notice, and so have I. Sit down. I could use someone who isn't afraid of the dark.",
			"choices": [
				{
					"text": "What problems?",
					"next": "wrong_things"
				}
			]
		},
		"report_hunter": {
			"text": "Walks wrong. Then Old Tam wasn't drunk after all.",
			"choices": [
				{
					"text": "Old Tam?",
					"next": "wrong_things"
				}
			]
		},
		"report_acolyte": {
			"text": "I wondered. Folk have stopped leaving candles there. And it's not the only thing gone quiet round here.",
			"choices": [
				{
					"text": "What else?",
					"next": "wrong_things"
				}
			],
			"set_flag": "silent_shrine_started"
		},
		"report_merchant": {
			"text": "Yellow canopy, driver who talked to his mules? It went north eleven days ago, slow and heavy. It never came back down, and Riverwatch never saw it. I'm sorry. It's not the only thing gone missing on this road.",
			"choices": [
				{
					"text": "What else is missing?",
					"next": "wrong_things"
				}
			],
			"set_flag": "lost_wagon_started"
		},
		"wrong_things": {
			"text": "Small wrong things. The wisps at the old stones are fading. I used to watch them from my door every night, and now there's barely a glimmer. And Old Tam, who hunts out past the hollow, came in two days ago white as milk. He'd found a Greyfang wolf that wouldn't run from him. Alive, he said, but grey all through, with eyes like a dead fire. He couldn't bring himself to put it down.",
			"set_flag": "maren_wrong_things",
			"choices": [
				{
					"text": "Where did he see it?",
					"next": "wolf_where"
				},
				{
					"text": "Probably sick. Wolves get sick.",
					"next": "wolf_sick"
				}
			]
		},
		"wolf_where": {
			"text": "East of Greyfang Hollow, past the old fence. If it's still standing there, it won't be hard to find. Nothing else out there stands still.",
			"choices": [
				{
					"text": "I'll take a look.",
					"next": "end"
				},
				{
					"text": "Tell me about the rest of the pack.",
					"next": "wolves",
					"requires_not_flag": "wolves_cleared"
				}
			]
		},
		"wolf_sick": {
			"text": "Tam's skinned a hundred sick wolves. He didn't come in white for a sick one. East of Greyfang Hollow, past the old fence, if you want to see for yourself.",
			"choices": [
				{
					"text": "I'll take a look.",
					"next": "end"
				},
				{
					"text": "Tell me about the rest of the pack.",
					"next": "wolves",
					"requires_not_flag": "wolves_cleared"
				}
			]
		},
		"hollow_found": {
			"text": "So Tam wasn't seeing things. A mark? Burnt in? No, I don't know it. Take it to Brannoc, the Riverwatch scout. He's camped by the old stones, west of here. If the garrison knows a mark, he will.",
			"set_flag": "told_maren_hollow",
			"choices": [
				{
					"text": "I'll find him.",
					"next": "end"
				}
			]
		},
		"end_intro": {
			"text": "You look like you've been through a hedge backwards and then through something worse. Sit. What happened out there?",
			"choices": [
				{
					"text": "(Show her the letter and the map.)",
					"next": "end_letter"
				}
			]
		},
		"end_letter": {
			"text": "She reads it twice, then puts her finger on the map, on this valley, and then on the eleven other marks. \"Twelve. Twelve places like the stones. And you killed the first thing they made.\" She folds it carefully and gives it back.",
			"choices": [
				{
					"text": "It followed me out of the barrow. The wisp.",
					"next": "end_wisp",
					"requires_flag": "freed_wisp"
				},
				{
					"text": "What do I do now?",
					"next": "end_maren"
				}
			]
		},
		"end_wisp": {
			"text": "She watches the wisp settle by the lamp. \"The ones at the stones used to do that, before. Then not everything's gone.\"",
			"choices": [
				{
					"text": "What do I do now?",
					"next": "end_maren"
				}
			]
		},
		"end_maren": {
			"text": "Now? Now you eat something, and sleep, and in the morning you go and find the second one. The road north goes further than Riverwatch. It always has.",
			"set_flag": [
				"told_maren_end",
				"demo_finished"
			],
			"choices": [
				{
					"text": "(Leave)",
					"next": "end"
				}
			]
		},
		"wolves_why": {
			"text": "Hunger. Tam says the deer up in the hollow have gone thin and grey, same as that wolf of his. Nothing's left out there worth eating except what's on the road.",
			"set_flag": "heard_greyfang_reason",
			"choices": [
				{
					"text": "I'll deal with them.",
					"next": "accept",
					"requires_not_flag": [
						"wolf_quest_accepted",
						"wolves_cleared"
					]
				},
				{
					"text": "Sounds like someone else's problem.",
					"next": "end",
					"set_flag": "refused_maren"
				}
			]
		},
		"end_hollow": {
			"text": "She looks at your hands before your face. Then she reads the letter twice, and puts her finger on this valley, and on the eleven other marks. \"You stopped the first thing they made,\" she says. \"And you've been drinking from the same cup as them.\" She gives the map back. \"Go and find the second one. When you do, ask yourself which side of the cage you're standing on.\"",
			"set_flag": [
				"told_maren_end",
				"demo_finished"
			],
			"choices": [
				{
					"text": "(Leave)",
					"next": "end"
				}
			]
		}
	}
}
